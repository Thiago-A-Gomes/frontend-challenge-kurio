{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx", "isolatedModules": true,
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true
    , "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"]
}
